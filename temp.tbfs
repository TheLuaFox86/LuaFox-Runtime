ocal args = txt:split(' ')\\\\\\\\n\\\\\\\\9\\\\\\\\9for i=1, #args do\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9args[i] = args[i]:gsub('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\s', ' ')\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9args[i] = args[i]:gsub('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n', '\\\\\\\\\\\\\\\\n')\\\\\\\\n\\\\\\\\9\\\\\\\\9end\\\\\\\\n\\\\\\\\9\\\\\\\\9local argsb = {}\\\\\\\\n\\\\\\\\9\\\\\\\\9for k, v in pairs(args) do\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9--print(k, v)\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9table.insert(argsb, v)\\\\\\\\n\\\\\\\\9\\\\\\\\9end\\\\\\\\n\\\\\\\\9\\\\\\\\9if args[1] == 'exit' then\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9term.history.save(fs.paths.User .. \\\\\\\\\\\\\\\".lfdev/lfsh_history\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9return true\\\\\\\\n\\\\\\\\9\\\\\\\\9elseif args[1] == 'cd' then\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9pwd = fs.pwd(args[2])\\\\\\\\n\\\\\\\\9\\\\\\\\9else\\\\\\\\n\\\\\\\\9\\\\\\\\9\\\\\\\\9log(cmdexec(table.unpack(argsb, 1, #argsb)))\\\\\\\\n\\\\\\\\9\\\\\\\\9end\\\\\\\\n\\\\\\\\9\\\\\\\\9term.write(\\\\\\\\\\\\\\\"CurrentDir: [\\\\\\\\\\\\\\\" .. pwd .. \\\\\\\\\\\\\\\"]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\\9end, true, '~~> ')\\\\\\\\nend\\\\\\\\n\\\\\\\", date = 0, type = \\\\\\\"file\\\\\\\"}, [\\\\\\\"/log.txt\\\\\\\"] = {content = \\\\\\\"creating api: lfrt:term version 0\\\\\\\\9\\\\\\\\nadded class: lfrt:term of type [api]\\\\\\\\9\\\\\\\\ncreating api: lfrt:filesystem version 0\\\\\\\\9\\\\\\\\nadded class: lfrt:filesystem of type [api]\\\\\\\\9\\\\\\\\ncreating api: lfrt:runtime version 0\\\\\\\\9\\\\\\\\nadded class: lfrt:runtime of type [api]\\\\\\\\9\\\\\\\\nfalse\\\\\\\\9lfrt:173: attempt to concatenate a nil value (global 'lfarP')\\\\\\\\9\\\\\\\\n\\\\\\\", date = 0, type = \\\\\\\"file\\\\\\\"}}\\\", date = 0, type = \\\"file\\\"}}\", date = 0, type = \"file\"}, [\"/_INFO_.lua\"] = {content = \"{\\n    packageID = \\\"io.github.TheLuaFox86.LFDEV\\\",\\n    packageName = \\\"LFDEV\\\", -- name of youre progeram\\n    packageVersion = 000000001, -- version seperated by three the something like 0.0.1 becomes 000000001 1.1.1 is 001001001 and so on, must be a number\\n    packageAuthor = \\\"TheLuaFox86\\\", -- the author of the package, can be any string\\n    packageDescription = \\\"A template for creating LFPK packages.\\\", -- a short description of the package, can be any string\\n    packageLicense = \\\"MIT\\\", -- license of the package, can be any license, but must be a valid SPDX license identifier. See https://spdx.org/licenses/ for a list of valid identifiers.\\n    packageDependencies = {\\n    },\\n    files = { -- package's removable files.\\n        [\\\"/lfrtBin/lfdev\\\"] = true, -- the files that are in the project, true if removable, false if not, the path is relative to a exisiting folder in the comnputer we dont want to delete. the _-_lfrtBin_-_ represents the platforms lfrtBin folder specified by LFPC (LuaFox Platform Core) in linux its $HOME/.config in windows its Users/<User>/%AppData%/roaming\\n    },\\n}\\n\", date = 0, type = \"file\"}, [\"/lfrtBin\"] = {date = 0, type = \"dir\"}, [\"/lfrtBin/lfdev.lfar\"] = {content = \"{[\\\"/Data\\\"] = {date = 0, type = \\\"dir\\\"}, [\\\"/Data/bin\\\"] = {date = 0, type = \\\"dir\\\"}, [\\\"/Data/bin/Update.lua\\\"] = {content = \\\"os.execute(\\\\\\\"lfrt launch lfpkm install TheLuaFox86/LuaFox-Runtime-Develoupment-Program master latest\\\\\\\")\\\\nlocal term = class:getAPI(\\\\\\\"term\\\\\\\", 0)\\\\nterm.write(\\\\\\\"to apply changes restart lfdev\\\\\\\\n\\\\\\\\nif you see that it does not launch try updating the luafox runtime to the recomended version (could be latest) \\\\\\\\n\\\\9\\\\9to see what version is recomended go to https://theluafox86.github.io/LuaFox-Runtime/status\\\\\\\\n\\\\\\\")\\\\n\\\", date = 0, type = \\\"file\\\"}, [\\\"/Data/lib\\\"] = {date = 0, type = \\\"dir\\\"}, [\\\"/Data/lib/001-lfsh.lua\\\"] = {content = \\\"do\\\\n\\\\9local lfsh = {}\\\\n\\\\9lfsh.vars = {}\\\\n\\\\9lfsh.methods = {\\\\n\\\\9\\\\9set = function(self, name, value)\\\\n\\\\9\\\\9\\\\9if name:match(\\\\\\\"$\\\\\\\") then\\\\n\\\\9\\\\9\\\\9\\\\9error(\\\\\\\"invalid character: '$'\\\\\\\", 0)\\\\n\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9self.vars[name] = value\\\\n\\\\9\\\\9end,\\\\n\\\\9}\\\\n\\\\9lfsh.callback = function() return end\\\\n\\\\9lfsh.parse = function(self, str)\\\\n\\\\9\\\\9local tb = {}\\\\n\\\\9\\\\9for _, v in ipairs(str:split(\\\\\\\" \\\\\\\")) do\\\\n\\\\9\\\\9\\\\9local val = v:gsub(\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\", \\\\\\\"\\\\\\\\n\\\\\\\"):gsub(\\\\\\\"\\\\\\\\\\\\\\\\s\\\\\\\", \\\\\\\" \\\\\\\"):gsub(\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\")\\\\n\\\\9\\\\9\\\\9for name, value in pairs(self.vars) do\\\\n\\\\9\\\\9\\\\9\\\\9local a = \\\\\\\"\\\\\\\"\\\\n\\\\9\\\\9\\\\9\\\\9if v:match(\\\\\\\"$\\\\\\\" .. name:upper() .. \\\\\\\"$\\\\\\\") then\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9for i, sv in ipairs(v:split(\\\\\\\"$\\\\\\\" .. name:upper() .. \\\\\\\"$\\\\\\\")) do\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9\\\\9if i >= #v:split(\\\\\\\"$\\\\\\\" .. name:upper() .. \\\\\\\"$\\\\\\\") and sv == \\\\\\\"\\\\\\\" then\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9\\\\9\\\\9a = a .. sv\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9\\\\9else\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9\\\\9\\\\9a = a .. value .. sv\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9\\\\9if a ~= \\\\\\\"\\\\\\\" then\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9val = a\\\\n\\\\9\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9log(val)\\\\n\\\\9\\\\9\\\\9table.insert(tb, val)\\\\n\\\\9\\\\9end\\\\n\\\\9\\\\9return tb\\\\n\\\\9end\\\\n\\\\9lfsh.exec = function(self, name, ...)`\\\\n\\\\9\\\\9if self.methods[name] then\\\\n\\\\9\\\\9\\\\9return pcall(self, self.methods[name], ...)\\\\n\\\\9\\\\9else\\\\n\\\\9\\\\9\\\\9return self:callback(name, ...)\\\\n\\\\9\\\\9end\\\\n\\\\9end\\\\n\\\\9class.lfrt.api.api(lfsh, \\\\\\\"lfdev:lfsh\\\\\\\", 0)\\\\nend\\\\n\\\", date = 0, type = \\\"file\\\"}, [\\\"/Data/motd.txt\\\"] = {content = \\\"\\\\n[!!!!!!!!!!!!!!!!!!!!!!!!!!!!]\\\\n           Warning:\\\\n   LFdev Is In Recovery Mode\\\\n    Please Run the \\\\\\\"Update\\\\\\\" \\\\n  command to install needed-\\\\n            files. \\\\n[!!!!!!!!!!!!!!!!!!!!!!!!!!!!]\\\\n\\\", date = 0, type = \\\"file\\\"}, [\\\"/_MAIN_.lua\\\"] = {content = \\\"local args = {...}\\\\nlocal csr = {}\\\\nlocal libp = {}\\\\nlocal tbfs = class:getAPI(\\\\\\\"tbfs\\\\\\\", 1)\\\\nlocal term = class:getAPI('lfrt:term', 2)\\\\nfunction _G.cmdexec(name, ...)\\\\n\\\\9local tb = {}\\\\n\\\\9local ok = false\\\\n\\\\9for _, v in ipairs(csr) do\\\\n\\\\9\\\\9local dotlua = fs.exists(v .. (name or \\\\\\\"lfsh\\\\\\\") .. '.lua')\\\\n\\\\9\\\\9local dotlfar = fs.exists(v .. (name or \\\\\\\"lfsh\\\\\\\") .. '.lfar')\\\\n\\\\9\\\\9if dotlua then\\\\n\\\\9\\\\9\\\\9local f, r = loadfile(v .. (name or \\\\\\\"lfsh\\\\\\\") .. '.lua', 't', _ENV)\\\\n\\\\9\\\\9\\\\9log(tostring(f), tostring(r))\\\\n\\\\9\\\\9\\\\9tb = table.pack(pcall(f, ...))\\\\n\\\\9\\\\9\\\\9ok = tb[1]\\\\n\\\\9\\\\9\\\\9if ok then\\\\n\\\\9\\\\9\\\\9\\\\9break\\\\n\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9elseif dotlfar then\\\\n\\\\9\\\\9\\\\9log(v .. (name or \\\\\\\"lfsh\\\\\\\") .. '.lfar', lfarP)\\\\n\\\\9\\\\9\\\\9tbfs.extract(v .. (name or \\\\\\\"lfsh\\\\\\\") .. '.lfar', lfarP)\\\\n\\\\9\\\\9\\\\9local f, r = loadfile(lfarP .. \\\\\\\"_MAIN_.lua\\\\\\\", 't', _ENV)\\\\n\\\\9\\\\9\\\\9log(tostring(f), v)\\\\n\\\\9\\\\9\\\\9ok = pcall(f, ...)\\\\n\\\\9\\\\9\\\\9if ok then\\\\n\\\\9\\\\9\\\\9\\\\9break\\\\n\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9end\\\\n\\\\9end\\\\n\\\\9if not ok then\\\\n\\\\9\\\\9if _PLATFORM[1] == 'linux' or _PLATFORM[1] == 'luafoxOS' then\\\\n\\\\9\\\\9\\\\9local str = ''\\\\n\\\\9\\\\9\\\\9for i, v in ipairs({name, ...}) do\\\\n\\\\9\\\\9\\\\9\\\\9str = str .. string.format(\\\\\\\"%q \\\\\\\", tostring(v))\\\\n\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9tb = {os.execute(string.format(\\\\\\\"bash -c %q\\\\\\\", str))}\\\\n\\\\9\\\\9end\\\\n\\\\9end\\\\n\\\\9return table.unpack(tb, 1, #tb)\\\\nend\\\\n\\\\nterm.clear()\\\\nterm.write('loading...\\\\\\\\n')\\\\nlocal fs = class:getAPI('lfrt:filesystem', 0)\\\\nif not fs.exists(fs.paths.User .. '.lfdev') then\\\\n\\\\9local tbfs = class:getAPI('tbfs', 0)\\\\n\\\\9fs.create(fs.paths.User .. \\\\\\\".lfdev\\\\\\\")\\\\n\\\\9tbfs.compress(lfarP .. 'Data/', lfarP .. 'data.tbfs')\\\\n\\\\9tbfs.extract(lfarP .. 'data.tbfs', fs.paths.User .. '.lfdev')\\\\nend\\\\n_G.lfdevP = fs.paths.User .. \\\\\\\".lfdev/\\\\\\\"\\\\ntable.insert(csr, fs.paths.User .. \\\\\\\".lfdev/bin/\\\\\\\")\\\\ntable.insert(csr, \\\\\\\"./\\\\\\\")\\\\ntable.insert(csr, fs.paths.lfrtBin)\\\\ntable.insert(libp, fs.paths.User .. \\\\\\\".lfdev/lib/\\\\\\\")\\\\nlocal lfdevP = fs.paths.User .. \\\\\\\".lfdev/\\\\\\\"\\\\nfor _, v in ipairs(libp) do\\\\n\\\\9for i=0, 999 do\\\\n\\\\9\\\\9for _, fn in ipairs(fs.list(v)) do\\\\n\\\\9\\\\9\\\\9if tonumber(fn:sub(1, 3)) == i then\\\\n\\\\9\\\\9\\\\9\\\\9log('loading module: ' .. fn)\\\\n\\\\9\\\\9\\\\9\\\\9local env = {}\\\\n\\\\9\\\\9\\\\9\\\\9for k, v in pairs(_ENV) do\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9env[k] = v\\\\n\\\\9\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\n\\\\9\\\\9\\\\9\\\\9env._G = env\\\\n\\\\9\\\\9\\\\9\\\\9local f, r = load(fs.readAll(v .. fn) .. '\\\\\\\\nreturn class', '=lib', \\\\\\\"t\\\\\\\", env)\\\\n\\\\9\\\\9\\\\9\\\\9if f and not r then \\\\n\\\\9\\\\9\\\\9\\\\9\\\\9local ok, r = pcall(f)\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9log(ok, r)\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9_G.class = r\\\\n\\\\9\\\\9\\\\9\\\\9else\\\\n\\\\9\\\\9\\\\9\\\\9\\\\9log('module failed to load: ' .. r)\\\\n\\\\9\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9\\\\9end\\\\n\\\\9\\\\9end\\\\n\\\\9end\\\\nend\\\\npwd = fs.pwd()\\\\n\\\\nif not fs.exists(fs.paths.User .. \\\\\\\".lfdev/motd.txt\\\\\\\") then\\\\n\\\\9fs.remove(fs.paths.User .. \\\\\\\".lfdev/\\\\\\\")\\\\n\\\\9term.write('please restart lfdev\\\\\\\\n')\\\\n\\\\9error(\\\\\\\"motd.txt not found: entering recovery mode\\\\\\\", 0)\\\\nend\\\\nfs.remove(lfarP)\\\\nfs.create(lfarP)\\\\nlocal lfsh = class:getAPI(\\\\\\\"lfdev:lfsh\\\\\\\", 0)\\\\nfor k, v in pairs(_G) do\\\\n\\\\9_ENV[k] = v\\\\nend\\\\nlfsh.vars = fs.paths\\\\nlfsh.vars.lfarp = lfarP\\\\nlfsh.vars.lfdevp = lfdevP\\\\nlfsh.callback = function(self, name, ...)\\\\n\\\\9return pcall(cmdexec, name, ...)\\\\nend\\\\nif args[1] then\\\\n\\\\9if fs.readAll(fs.paths.User .. \\\\\\\".lfdev/motd.txt\\\\\\\"):match(\\\\\\\"Warning:\\\\\\\") and args[1] ~= \\\\\\\"Update\\\\\\\" then\\\\n\\\\9\\\\9term.write(term.colors.yellow .. fs.readAll(fs.paths.User .. \\\\\\\".lfdev/motd.txt\\\\\\\") .. term.colors.white)\\\\n\\\\9\\\\9term.write(\\\\\\\"could not run command \\\\\\\" .. args[1])\\\\n\\\\9\\\\9error(\\\\\\\"lfdev in recovery\\\\\\\")\\\\n\\\\9else\\\\n\\\\9\\\\9cmdexec(args[1], table.unpack(args, 2, #args))\\\\n\\\\9end\\\\nelse\\\\n\\\\9term.clear()\\\\n\\\\9if fs.readAll(fs.paths.User .. \\\\\\\".lfdev/motd.txt\\\\\\\"):match(\\\\\\\"Warning:\\\\\\\")\\\\9then\\\\n\\\\9\\\\9term.write(term.colors.yellow)\\\\n\\\\9end\\\\n\\\\9term.write(\\\\\\\"\\\\\\\" .. fs.readAll(fs.paths.User .. \\\\\\\".lfdev/motd.txt\\\\\\\") .. term.colors.white)\\\\n\\\\n\\\\9term.write('LFDev Terminal (LuaFox Runtime) Alpha1\\\\\\\\n\\\\\\\\n')\\\\n\\\\9term.write(\\\\\\\"CurrentDir: [\\\\\\\" .. pwd .. \\\\\\\"]\\\\\\\\n\\\\\\\")\\\\n\\\\9if fs.exists(fs.paths.User .. \\\\\\\".lfdev/lfsh_history\\\\\\\") then\\\\n\\\\9\\\\9term.history.load(fs.paths.User .. \\\\\\\".lfdev/lfsh_history\\\\\\\")\\\\n\\\\9end\\\\n\\\\9term.read(function(txt)\\\\n\\\\9\\\\9\\\\n\\\\9\\\\9log(lfsh)\\\\n\\\\9\\\\9term.history.add(txt)\\\\n\\\\9\\\\9local args = lfsh:parse(txt)\\\\n\\\\9\\\\9if args[1] == 'exit' then\\\\n\\\\9\\\\9\\\\9term.history.save(fs.paths.User .. \\\\\\\".lfdev/lfsh_history\\\\\\\")\\\\n\\\\9\\\\9\\\\9return true\\\\n\\\\9\\\\9elseif args[1] == 'cd' then\\\\n\\\\9\\\\9\\\\9pwd = fs.pwd(args[2])\\\\n\\\\9\\\\9else\\\\n\\\\9\\\\9\\\\9lfsh:exec(table.unpack(args))\\\\n\\\\9\\\\9end\\\\n\\\\9\\\\9term.write(\\\\\\\"CurrentDir: [\\\\\\\" .. pwd .. \\\\\\\"]\\\\\\\\n\\\\\\\")\\\\n\\\\9end, true, '~~> ')\\\\nend\\\\n\\\", date = 0, type = \\\"file\\\"}}\", date = 0, type = \"file\"}}", date = 0, type = "file"}, ["/_INFO_.lua"] = {content = "{\n    packageID = \"io.github.TheLuaFox86.LFDEV\",\n    packageName = \"LFDEV\", -- name of youre progeram\n    packageVersion = 000000001, -- version seperated by three the something like 0.0.1 becomes 000000001 1.1.1 is 001001001 and so on, must be a number\n    packageAuthor = \"TheLuaFox86\", -- the author of the package, can be any string\n    packageDescription = \"A template for creating LFPK packages.\", -- a short description of the package, can be any string\n    packageLicense = \"MIT\", -- license of the package, can be any license, but must be a valid SPDX license identifier. See https://spdx.org/licenses/ for a list of valid identifiers.\n    packageDependencies = {\n    },\n    files = { -- package's removable files.\n        [\"/lfrtBin/lfdev\"] = true, -- the files that are in the project, true if removable, false if not, the path is relative to a exisiting folder in the comnputer we dont want to delete. the _-_lfrtBin_-_ represents the platforms lfrtBin folder specified by LFPC (LuaFox Platform Core) in linux its $HOME/.config in windows its Users/<User>/%AppData%/roaming\n    },\n}\n", date = 0, type = "file"}, ["/home/luafox"] = {date = 0, type = "dir"}, ["/home/luafox/.config/lfrt/prg"] = {date = 0, type = "dir"}, ["/home/luafox/.config/lfrt/prg/lfdev.lfar"] = {content = "{[\"/Data\"] = {date = 0, type = \"dir\"}, [\"/Data/bin\"] = {date = 0, type = \"dir\"}, [\"/Data/bin/Update.lua\"] = {content = \"os.execute(\\\"lfrt launch lfpkm install TheLuaFox86/LuaFox-Runtime-Develoupment-Program master latest\\\")\\nlocal term = class:getAPI(\\\"term\\\", 0)\\nterm.write(\\\"to apply changes restart lfdev\\\\n\\\\nif you see that it does not launch try updating the luafox runtime to the recomended version (could be latest) \\\\n\\9\\9to see what version is recomended go to https://theluafox86.github.io/LuaFox-Runtime/status\\\\n\\\")\\n\", date = 0, type = \"file\"}, [\"/Data/lib\"] = {date = 0, type = \"dir\"}, [\"/Data/lib/001-lfsh.lua\"] = {content = \"do\\n\\9local lfsh = {}\\n\\9lfsh.vars = {}\\n\\9lfsh.methods = {\\n\\9\\9set = function(self, name, value)\\n\\9\\9\\9for i=1, #name do\\n\\9\\9\\9\\9if name:sub(i, i) == \\\"$\\\" then\\n\\9\\9\\9\\9\\9error(\\\"invalid character $\\\", 0)\\n\\9\\9\\9\\9end\\n\\9\\9\\9end\\n\\9\\9\\9self.vars[name] = value\\n\\9\\9end,\\n\\9}\\n\\9lfsh.callback = function() return end\\n\\9lfsh.parse = function(self, str)\\n\\9\\9local tb = {}\\n\\9\\9for _, v in ipairs(str:split(\\\" \\\")) do\\n\\9\\9\\9local val = v:gsub(\\\"\\\\\\\\n\\\", \\\"\\\\n\\\"):gsub(\\\"\\\\\\\\s\\\", \\\" \\\"):gsub(\\\"\\\\\\\\\\\\\\\\\\\", \\\"\\\\\\\\\\\")\\n\\9\\9\\9for name, value in pairs(self.vars) do\\n\\9\\9\\9\\9local ident = \\\"$\\\" .. name:upper() .. \\\"$\\\"\\n\\9\\9\\9\\9log(name, value)\\n\\9\\9\\9\\9local a = \\\"\\\"\\n\\9\\9\\9\\9local found = false\\n\\9\\9\\9\\9\\n\\9\\9\\9\\9for i=1, #val do\\n\\9\\9\\9\\9\\9if val:sub(i, i + #ident) == ident then\\n\\9\\9\\9\\9\\9\\9found = true\\n\\9\\9\\9\\9\\9end\\n\\9\\9\\9\\9end\\n\\9\\9\\9\\9if found then\\n\\9\\9\\9\\9\\9for i, sv in ipairs(v:split(\\\"$\\\" .. name:upper() .. \\\"$\\\")) do\\n\\9\\9\\9\\9\\9\\9if i >= #v:split(\\\"$\\\" .. name:upper() .. \\\"$\\\") and sv == \\\"\\\" then\\n\\9\\9\\9\\9\\9\\9\\9a = a .. sv\\n\\9\\9\\9\\9\\9\\9else\\n\\9\\9\\9\\9\\9\\9\\9a = a .. value .. sv\\n\\9\\9\\9\\9\\9\\9end\\n\\9\\9\\9\\9\\9end\\n\\9\\9\\9\\9end\\n\\9\\9\\9\\9if a ~= \\\"\\\" then\\n\\9\\9\\9\\9\\9val = a\\n\\9\\9\\9\\9end\\n\\9\\9\\9end\\n\\9\\9\\9log(val)\\n\\9\\9\\9table.insert(tb, val)\\n\\9\\9end\\n\\9\\9return tb\\n\\9end\\n\\9lfsh.exec = function(self, name, ...)\\n\\9\\9if self.methods[name] then\\n\\9\\9\\9return pcall(self.methods[name], self, ...)\\n\\9\\9else\\n\\9\\9\\9return self:callback(name, ...)\\n\\9\\9end\\n\\9end\\n\\9class.lfrt.api.api(lfsh, \\\"lfdev:lfsh\\\", 0)\\nend\\n\", date = 0, type = \"file\"}, [\"/Data/motd.txt\"] = {content = \"\\n[!!!!!!!!!!!!!!!!!!!!!!!!!!!!]\\n           Warning:\\n   LFdev Is In Recovery Mode\\n    Please Run the \\\"Update\\\" \\n  command to install needed-\\n            files. \\n[!!!!!!!!!!!!!!!!!!!!!!!!!!!!]\\n\", date = 0, type = \"file\"}, [\"/_MAIN_.lua\"] = {content = \"local args = {...}\\nlocal csr = {}\\nlocal libp = {}\\nlocal tbfs = class:getAPI(\\\"tbfs\\\", 1)\\nlocal term = class:getAPI('lfrt:term', 2)\\nfunction _G.cmdexec(name, ...)\\n\\9local tb = {}\\n\\9local ok = false\\n\\9for _, v in ipairs(csr) do\\n\\9\\9local dotlua = fs.exists(v .. (name or \\\"lfsh\\\") .. '.lua')\\n\\9\\9local dotlfar = fs.exists(v .. (name or \\\"lfsh\\\") .. '.lfar')\\n\\9\\9if dotlua then\\n\\9\\9\\9local f, r = loadfile(v .. (name or \\\"lfsh\\\") .. '.lua', 't', _ENV)\\n\\9\\9\\9log(tostring(f), tostring(r))\\n\\9\\9\\9tb = table.pack(pcall(f, ...))\\n\\9\\9\\9ok = tb[1]\\n\\9\\9\\9if ok then\\n\\9\\9\\9\\9break\\n\\9\\9\\9end\\n\\9\\9elseif dotlfar then\\n\\9\\9\\9log(v .. (name or \\\"lfsh\\\") .. '.lfar', lfarP)\\n\\9\\9\\9tbfs.extract(v .. (name or \\\"lfsh\\\") .. '.lfar', lfarP)\\n\\9\\9\\9local f, r = loadfile(lfarP .. \\\"_MAIN_.lua\\\", 't', _ENV)\\n\\9\\9\\9log(tostring(f), v)\\n\\9\\9\\9ok = pcall(f, ...)\\n\\9\\9\\9if ok then\\n\\9\\9\\9\\9break\\n\\9\\9\\9end\\n\\9\\9end\\n\\9end\\n\\9if not ok then\\n\\9\\9if _PLATFORM[1] == 'linux' or _PLATFORM[1] == 'luafoxOS' then\\n\\9\\9\\9local str = ''\\n\\9\\9\\9for i, v in ipairs({name, ...}) do\\n\\9\\9\\9\\9str = str .. string.format(\\\"%q \\\", tostring(v))\\n\\9\\9\\9end\\n\\9\\9\\9tb = {os.execute(string.format(\\\"bash -c %q\\\", str))}\\n\\9\\9end\\n\\9end\\n\\9return table.unpack(tb, 1, #tb)\\nend\\n\\nterm.clear()\\nterm.write('loading...\\\\n')\\nlocal fs = class:getAPI('lfrt:filesystem', 0)\\nif not fs.exists(fs.paths.User .. '.lfdev') then\\n\\9local tbfs = class:getAPI('tbfs', 0)\\n\\9fs.create(fs.paths.User .. \\\".lfdev\\\")\\n\\9tbfs.compress(lfarP .. 'Data/', lfarP .. 'data.tbfs')\\n\\9tbfs.extract(lfarP .. 'data.tbfs', fs.paths.User .. '.lfdev')\\nend\\n_G.lfdevP = fs.paths.User .. \\\".lfdev/\\\"\\ntable.insert(csr, fs.paths.User .. \\\".lfdev/bin/\\\")\\ntable.insert(csr, \\\"./\\\")\\ntable.insert(csr, fs.paths.lfrtBin)\\ntable.insert(libp, fs.paths.User .. \\\".lfdev/lib/\\\")\\nlocal lfdevP = fs.paths.User .. \\\".lfdev/\\\"\\nfor _, v in ipairs(libp) do\\n\\9for i=0, 999 do\\n\\9\\9for _, fn in ipairs(fs.list(v)) do\\n\\9\\9\\9if tonumber(fn:sub(1, 3)) == i then\\n\\9\\9\\9\\9log('loading module: ' .. fn)\\n\\9\\9\\9\\9local env = {}\\n\\9\\9\\9\\9for k, v in pairs(_ENV) do\\n\\9\\9\\9\\9\\9env[k] = v\\n\\9\\9\\9\\9end\\n\\9\\9\\n\\9\\9\\9\\9env._G = env\\n\\9\\9\\9\\9local f, r = load(fs.readAll(v .. fn) .. '\\\\nreturn class', '=lib', \\\"t\\\", env)\\n\\9\\9\\9\\9if f and not r then \\n\\9\\9\\9\\9\\9local ok, r = pcall(f)\\n\\9\\9\\9\\9\\9log(ok, r)\\n\\9\\9\\9\\9\\9_G.class = r\\n\\9\\9\\9\\9else\\n\\9\\9\\9\\9\\9log('module failed to load: ' .. r)\\n\\9\\9\\9\\9end\\n\\9\\9\\9end\\n\\9\\9end\\n\\9end\\nend\\npwd = fs.pwd()\\n\\nif not fs.exists(fs.paths.User .. \\\".lfdev/motd.txt\\\") then\\n\\9fs.remove(fs.paths.User .. \\\".lfdev/\\\")\\n\\9term.write('please restart lfdev\\\\n')\\n\\9error(\\\"motd.txt not found: entering recovery mode\\\", 0)\\nend\\nfs.remove(lfarP)\\nfs.create(lfarP)\\nlocal lfsh = class:getAPI(\\\"lfdev:lfsh\\\", 0)\\nfor k, v in pairs(_G) do\\n\\9_ENV[k] = v\\nend\\nlfsh.lfdev = {}\\nlfsh.vars = fs.paths\\nlfsh.vars.lfarp = lfarP\\nlfsh.vars.lfdevp = lfdevP\\nlfsh.callback = function(self, name, ...)\\n\\9return pcall(cmdexec, name, ...)\\nend\\nlfsh:push()\\nif args[1] then\\n\\9if fs.readAll(fs.paths.User .. \\\".lfdev/motd.txt\\\"):match(\\\"Warning:\\\") and args[1] ~= \\\"Update\\\" then\\n\\9\\9term.write(term.colors.yellow .. fs.readAll(fs.paths.User .. \\\".lfdev/motd.txt\\\") .. term.colors.white)\\n\\9\\9term.write(\\\"could not run command \\\" .. args[1])\\n\\9\\9error(\\\"lfdev in recovery\\\")\\n\\9else\\n\\9\\9cmdexec(args[1], table.unpack(args, 2, #args))\\n\\9end\\nelse\\n\\9term.clear()\\n\\9if fs.readAll(fs.paths.User .. \\\".lfdev/motd.txt\\\"):match(\\\"Warning:\\\")\\9then\\n\\9\\9term.write(term.colors.yellow)\\n\\9end\\n\\9term.write(\\\"\\\" .. fs.readAll(fs.paths.User .. \\\".lfdev/motd.txt\\\") .. term.colors.white)\\n\\n\\9term.write('LFDev Terminal (LuaFox Runtime) Alpha1\\\\n\\\\n')\\n\\9term.write(\\\"CurrentDir: [\\\" .. pwd .. \\\"]\\\\n\\\")\\n\\9if fs.exists(fs.paths.User .. \\\".lfdev/lfsh_history\\\") then\\n\\9\\9term.history.load(fs.paths.User .. \\\".lfdev/lfsh_history\\\")\\n\\9end\\n\\9term.read(function(txt)\\n\\9\\9\\n\\9\\9log(lfsh)\\n\\9\\9term.history.add(txt)\\n\\9\\9local args = lfsh:parse(txt)\\n\\9\\9if args[1] == 'exit' then\\n\\9\\9\\9term.history.save(fs.paths.User .. \\\".lfdev/lfsh_history\\\")\\n\\9\\9\\9return true\\n\\9\\9elseif args[1] == 'cd' then\\n\\9\\9\\9pwd = fs.pwd(args[2])\\n\\9\\9else\\n\\9\\9\\9log(lfsh:exec(table.unpack(args)))\\n\\9\\9end\\n\\9\\9term.write(\\\"CurrentDir: [\\\" .. pwd .. \\\"]\\\\n\\\")\\n\\9\\9lfsh:push()\\n\\9end, true, '~~> ')\\nend\\n\", date = 0, type = \"file\"}}", date = 0, type = "file"}, ["/home/luafox/.lfdev"] = {date = 0, type = "dir"}, ["/home/luafox/.lfdev/bin"] = {date = 0, type = "dir"}, ["/home/luafox/.lfdev/bin/External.lua"] = {content = "--check platform--\nif _PLATFORM[1] == 'linux' then\n\9local str = ''\n\9for i, v in ipairs({...}) do\n\9\9str = str .. string.format(\"%q \", tostring(v))\n\9end\n\9os.execute(str)\nelse\n\9error('cannot run external command: unsupported platform', 0)\nend", date = 0, type = "file"}, ["/home/luafox/.lfdev/bin/Update.lua"] = {content = "os.execute(\"lfrt launch lfpkm install TheLuaFox86/LuaFox-Runtime-Develoupment-Program master latest\")\nlocal term = class:getAPI(\"term\", 0)\nterm.write(\"to apply changes restart lfdev\\n\\nif you see that it does not launch try updating the luafox runtime to the recomended version (could be latest) \\n\9\9to see what version is recomended go to https://theluafox86.github.io/LuaFox-Runtime/status\\n\")\n", date = 0, type = "file"}, ["/home/luafox/.lfdev/bin/tbfs.lua"] = {content = "local args = {...}\nlocal fs = class:getAPI('filesystem', 0)\nlocal tbfs = class:getAPI(\"tbfs\", 0)\nif args then\n\9if args[1] == '-c' then\n\9\9tbfs.compress(args[2], (args[3] or \"./out.tbfs\"))\n\9elseif args[1] == '-e' then\n\9\9tbfs.extract(args[2], (args[3] or args[2] .. \"-out\"))\n\9end\nelse\n\9print([[\nUSAGE: tbfs <-c|-e> <from> [destination]\n\nSYMPASIS: tbfs -c ./ workingdirArchive.tbfs\n\ncreates or extracts lua table filesystem archives (.tbfs)\n\ncan be used for creating lfpk and lfar files\n\nby TheLuaFox86\n\9]])\nend\n", date = 0, type = "file"}, ["/home/luafox/.lfdev/lib"] = {date = 0, type = "dir"}, ["/home/luafox/.lfdev/lib/001-json.lua"] = {content = "\n", date = 0, type = "file"}, ["/home/luafox/.lfdev/lib/001-lfsh.lua"] = {content = "do\n\9local lfsh = {}\n\9lfsh.vars = {}\n\9lfsh.methods = {\n\9\9set = function(self, name, value)\n\9\9\9for i=1, #name do\n\9\9\9\9if name:sub(i, i) == \"$\" then\n\9\9\9\9\9error(\"invalid character $\", 0)\n\9\9\9\9end\n\9\9\9end\n\9\9\9self.vars[name] = value\n\9\9end,\n\9}\n\9lfsh.callback = function() return end\n\9lfsh.parse = function(self, str)\n\9\9local tb = {}\n\9\9for _, v in ipairs(str:split(\" \")) do\n\9\9\9local val = v:gsub(\"\\\\n\", \"\\n\"):gsub(\"\\\\s\", \" \"):gsub(\"\\\\\\\\\", \"\\\\\")\n\9\9\9for name, value in pairs(self.vars) do\n\9\9\9\9local ident = \"$\" .. name:upper() .. \"$\"\n\9\9\9\9log(name, value)\n\9\9\9\9local a = \"\"\n\9\9\9\9local found = false\n\9\9\9\9\n\9\9\9\9for i=1, #val do\n\9\9\9\9\9if val:sub(i, i + #ident) == ident then\n\9\9\9\9\9\9found = true\n\9\9\9\9\9end\n\9\9\9\9end\n\9\9\9\9if found then\n\9\9\9\9\9for i, sv in ipairs(v:split(\"$\" .. name:upper() .. \"$\")) do\n\9\9\9\9\9\9if i >= #v:split(\"$\" .. name:upper() .. \"$\") and sv == \"\" then\n\9\9\9\9\9\9\9a = a .. sv\n\9\9\9\9\9\9else\n\9\9\9\9\9\9\9a = a .. value .. sv\n\9\9\9\9\9\9end\n\9\9\9\9\9end\n\9\9\9\9end\n\9\9\9\9if a ~= \"\" then\n\9\9\9\9\9val = a\n\9\9\9\9end\n\9\9\9end\n\9\9\9log(val)\n\9\9\9table.insert(tb, val)\n\9\9end\n\9\9return tb\n\9end\n\9lfsh.exec = function(self, name, ...)\n\9\9if self.methods[name] then\n\9\9\9return pcall(self.methods[name], self, ...)\n\9\9else\n\9\9\9return self:callback(name, ...)\n\9\9end\n\9end\n\9class.lfrt.api.api(lfsh, \"lfdev:lfsh\", 0)\nend\n", date = 0, type = "file"}, ["/home/luafox/.lfdev/motd.txt"] = {content = "\n\nWellcome!\n\n", date = 0, type = "file"}}