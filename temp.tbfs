{["/_FILES_.tbfs"] = {content = "{[\"/User\"] = {date = 0, type = \"dir\"}, [\"/User/.lfdev\"] = {date = 0, type = \"dir\"}, [\"/User/.lfdev/bin\"] = {date = 0, type = \"dir\"}, [\"/User/.lfdev/bin/External.lua\"] = {content = \"--check platform--\\nif _PLATFORM[1] == 'linux' then\\n\\9local str = ''\\n\\9for i, v in ipairs({...}) do\\n\\9\\9str = str .. string.format(\\\"%q \\\", tostring(v))\\n\\9end\\n\\9os.execute(str)\\nelse\\n\\9error('cannot run external command: unsupported platform', 0)\\nend\", date = 0, type = \"file\"}, [\"/User/.lfdev/bin/Update.lua\"] = {content = \"os.execute(\\\"lfrt launch lfpkm install TheLuaFox86/LuaFox-Runtime-Develoupment-Program master latest\\\")\\nlocal term = class:getAPI(\\\"term\\\", 0)\\nterm.write(\\\"to apply changes restart lfdev\\\\n\\\\nif you see that it does not launch try updating the luafox runtime to the recomended version (could be latest) \\\\n\\9\\9to see what version is recomended go to https://theluafox86.github.io/LuaFox-Runtime/status\\\\n\\\")\\n\", date = 0, type = \"file\"}, [\"/User/.lfdev/bin/tbfs.lua\"] = {content = \"local args = {...}\\nlocal fs = class:getAPI('filesystem', 0)\\nlocal tbfs = class:getAPI(\\\"tbfs\\\", 0)\\nif args then\\n\\9if args[1] == '-c' then\\n\\9\\9tbfs.compress(args[2], (args[3] or \\\"./out.tbfs\\\"))\\n\\9elseif args[1] == '-e' then\\n\\9\\9tbfs.extract(args[2], (args[3] or args[2] .. \\\"-out\\\"))\\n\\9end\\nelse\\n\\9print([[\\nUSAGE: tbfs <-c|-e> <from> [destination]\\n\\nSYMPASIS: tbfs -c ./ workingdirArchive.tbfs\\n\\ncreates or extracts lua table filesystem archives (.tbfs)\\n\\ncan be used for creating lfpk and lfar files\\n\\nby TheLuaFox86\\n\\9]])\\nend\\n\", date = 0, type = \"file\"}, [\"/User/.lfdev/lib\"] = {date = 0, type = \"dir\"}, [\"/User/.lfdev/lib/001-json.lua\"] = {content = \"\\n\", date = 0, type = \"file\"}, [\"/User/.lfdev/lib/001-lfsh.lua\"] = {content = \"do\\n\\9local lfsh = {}\\n\\9lfsh.vars = {}\\n\\9lfsh.methods = {\\n\\9\\9set = function(self, name, value)\\n\\9\\9\\9if name:match(\\\"$\\\") then\\n\\9\\9\\9\\9error(\\\"invalid character: '$'\\\", 0)\\n\\9\\9\\9end\\n\\9\\9\\9self.vars[name] = value\\n\\9\\9end,\\n\\9}\\n\\9lfsh.callback = function() return end\\n\\9lfsh.parse = function(self, str)\\n\\9\\9local tb = {}\\n\\9\\9for _, v in ipairs(str:split(\\\" \\\")) do\\n\\9\\9\\9local val = v:gsub(\\\"\\\\\\\\n\\\", \\\"\\\\n\\\"):gsub(\\\"\\\\\\\\s\\\", \\\" \\\"):gsub(\\\"\\\\\\\\\\\\\\\\\\\", \\\"\\\\\\\\\\\")\\n\\9\\9\\9for name, value in pairs(self.vars) do\\n\\9\\9\\9\\9local a = \\\"\\\"\\n\\9\\9\\9\\9if v:match(\\\"$\\\" .. name:upper() .. \\\"$\\\") then\\n\\9\\9\\9\\9\\9for i, sv in ipairs(v:split(\\\"$\\\" .. name:upper() .. \\\"$\\\")) do\\n\\9\\9\\9\\9\\9\\9if i >= v:split(\\\"$\\\" .. name:upper() .. \\\"$\\\") then\\n\\9\\9\\9\\9\\9\\9\\9a = a .. sv\\n\\9\\9\\9\\9\\9\\9else\\n\\9\\9\\9\\9\\9\\9\\9a = a .. value .. sv\\n\\9\\9\\9\\9\\9\\9end\\n\\9\\9\\9\\9\\9end\\n\\9\\9\\9\\9end\\n\\9\\9\\9\\9if a ~= \\\"\\\" then\\n\\9\\9\\9\\9\\9val = a\\n\\9\\9\\9\\9end\\n\\9\\9\\9end\\n\\9\\9\\9log(val)\\n\\9\\9\\9table.insert(tb, val)\\n\\9\\9end\\n\\9\\9return tb\\n\\9end\\n\\9lfsh.exec = function(self, name, ...)\\n\\9\\9if self.methods[name] then\\n\\9\\9\\9return pcall(self, self.methods[name], ...)\\n\\9\\9else\\n\\9\\9\\9return self:callback(name, ...)\\n\\9\\9end\\n\\9end\\n\\9class.lfrt.api.api(lfsh, \\\"lfdev:lfsh\\\", 0)\\nend\\n\", date = 0, type = \"file\"}, [\"/User/.lfdev/motd.txt\"] = {content = \"\\n\\nWellcome!\\n\\n\", date = 0, type = \"file\"}, [\"/_FILES_.tbfs\"] = {content = \"{[\\\"/User\\\"] = {date = 0, type = \\\"dir\\\"}, [\\\"/User/.lfdev\\\"] = {date = 0, type = \\\"dir\\\"}, [\\\"/User/.lfdev/bin\\\"] = {date = 0, type = \\\"dir\\\"}, [\\\"/User/.lfdev/bin/External.lua\\\"] = {content = \\\"--check platform--\\\\nif _PLATFORM[1] == 'linux' then\\\\n\\\\9local str = ''\\\\n\\\\9for i, v in ipairs({...}) do\\\\n\\\\9\\\\9str = str .. string.format(\\\\\\\"%q \\\\\\\", tostring(v))\\\\n\\\\9end\\\\n\\\\9os.execute(str)\\\\nelse\\\\n\\\\9error('cannot run external command: unsupported platform', 0)\\\\nend\\\", date = 0, type = \\\"file\\\"}, [\\\"/User/.lfdev/bin/Update.lua\\\"] = {content = \\\"os.execute(\\\\\\\"lfrt launch lfpkm install TheLuaFox86/LuaFox-Runtime-Develoupment-Program master latest\\\\\\\")\\\\nlocal term = class:getAPI(\\\\\\\"term\\\\\\\", 0)\\\\nterm.write(\\\\\\\"to apply changes restart lfdev\\\\\\\\n\\\\\\\\nif you see that it does not launch try updating the luafox runtime to the recomended version (could be latest) \\\\\\\\n\\\\9\\\\9to see what version is recomended go to https://theluafox86.github.io/LuaFox-Runtime/status\\\\\\\\n\\\\\\\")\\\\n\\\", date = 0, type = \\\"file\\\"}, [\\\"/User/.lfdev/bin/tbfs.lua\\\"] = {content = \\\"local args = {...}\\\\nlocal fs = class:getAPI('filesystem', 0)\\\\nlocal tbfs = class:getAPI(\\\\\\\"tbfs\\\\\\\", 0)\\\\nif args then\\\\n\\\\9if args[1] == '-c' then\\\\n\\\\9\\\\9tbfs.compress(args[2], (args[3] or \\\\\\\"./out.tbfs\\\\\\\"))\\\\n\\\\9elseif args[1] == '-e' then\\\\n\\\\9\\\\9tbfs.extract(args[2], (args[3] or args[2] .. \\\\\\\"-out\\\\\\\"))\\\\n\\\\9end\\\\nelse\\\\n\\\\9print([[\\\\nUSAGE: tbfs <-c|-e> <from> [destination]\\\\n\\\\nSYMPASIS: tbfs -c ./ workingdirArchive.tbfs\\\\n\\\\ncreates or extracts lua table filesystem archives (.tbfs)\\\\n\\\\ncan be used for creating lfpk and lfar files\\\\n\\\\nby TheLuaFox86\\\\n\\\\9]])\\\\nend\\\\n\\\", date = 0, type = \\\"file\\\"}, [\\\"/User/.lfdev/lib\\\"] = {date = 0, type = \\\"dir\\\"}, [\\\"/User/.lfdev/lib/001-json.lua\\\"] = {content = \\\"\\\\n\\\", date = 0, type = \\\"file\\\"}, [\\\"/User/.lfdev/motd.txt\\\"] = {content = \\\"\\\\n\\\\nWellcome!\\\\n\\\\n\\\", date = 0, type = \\\"file\\\"}, [\\\"/_FILES_.tbfs\\\"] = {content = \\\"{[\\\\\\\"/User\\\\\\\"] = {date = 0, type = \\\\\\\"dir\\\\\\\"}, [\\\\\\\"/User/.lfdev\\\\\\\"] = {date = 0, type = \\\\\\\"dir\\\\\\\"}, [\\\\\\\"/User/.lf